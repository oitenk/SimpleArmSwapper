// r6/scripts/simple_arm_swapper/SimpleArmSwapperStyleData.reds
// GENERATED from the game's character customization data (female_cco and male_cco) and the arm
// style appearance files. Do not edit by hand; regenerate with tools/gen_style_data.py.
//
// For every arm cyberware style, the pieces of V's arms it changes while the arms are out: piece
// name, mesh, look and chunk mask (which parts of the mesh show). keepSkin pieces keep the
// player's skin tone as their look. hide pieces are plain-style pieces the style leaves out.
module SimpleArmSwapperMod

public class ArmSwapperStylePiece {
    public let key: CName;
    public let comp: CName;
    public let mesh: ResRef;
    public let app: CName;
    public let keepSkin: Bool;
    public let mask: Uint64;
    public let hide: Bool;
}

public class ArmSwapperElementHint {
    public let key: CName;
    public let comp: CName;
    public let app: CName;
    public let element: CName;
}

public func ArmSwapperStylePieceNew(key: CName, comp: CName, mesh: ResRef, app: CName, keepSkin: Bool, mask: Uint64, hide: Bool) -> ref<ArmSwapperStylePiece> {
    let p: ref<ArmSwapperStylePiece> = new ArmSwapperStylePiece();
    p.key = key; p.comp = comp; p.mesh = mesh; p.app = app; p.keepSkin = keepSkin; p.mask = mask; p.hide = hide;
    return p;
}

public func ArmSwapperElementHintNew(key: CName, comp: CName, app: CName, element: CName) -> ref<ArmSwapperElementHint> {
    let h: ref<ArmSwapperElementHint> = new ArmSwapperElementHint();
    h.key = key; h.comp = comp; h.app = app; h.element = element;
    return h;
}

